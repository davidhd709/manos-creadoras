# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/manoscreadoras
POSTGRES_PASSWORD=changeme

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Autenticación ─────────────────────────────────────────────────────────────
# Genera un valor seguro: openssl rand -base64 48
JWT_SECRET=cambia_esto_por_un_secreto_de_al_menos_32_caracteres

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
# Para Gmail: genera una "contraseña de aplicación" en myaccount.google.com/security
MAIL_PASS=tu_contrasena_de_aplicacion
MAIL_FROM=Manos Creadoras <noreply@manoscreadoras.com>

# ── Notificaciones internas ───────────────────────────────────────────────────
# Recibe alertas de nuevos artesanos registrados y pedidos
ADMIN_NOTIFICATIONS_EMAIL=admin@manoscreadoras.com
# Solo dígitos, formato internacional sin "+". Ej: 573001234567
SUPPORT_WHATSAPP=573001234567

# ── Superadmin (solo para el script: pnpm seed:superadmin) ───────────────────
SUPERADMIN_EMAIL=superadmin@manoscreadoras.com
SUPERADMIN_PASSWORD=SuperAdmin2024!
SUPERADMIN_NAME=Super Administrador
